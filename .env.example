VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLIC-PUBLISHABLE-KEY

# SERVER ONLY: never use a VITE_ prefix for these.
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
CHAT_ENABLED=true
# Public feature flag; false hides the widget after rebuild.
VITE_CHAT_ENABLED=true
# Public endpoint path; NVIDIA_API_KEY stays server-only in Vercel.
VITE_CHAT_API_URL=/api/chat
